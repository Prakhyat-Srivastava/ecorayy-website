---
interface Props { label?: string; title: string; text?: string; center?: boolean; id?: string; as?: 'h1' | 'h2' }
const { label, title, text, center = false, id, as: Tag = 'h2' } = Astro.props;
---
<div class:list={['section-head reveal', { 'section-head--center': center }]}>
  {label && <span class="label">{label}</span>}
  <Tag id={id} class:list={[Tag === 'h1' ? 'h1' : 'h2']}>{title}</Tag>
  {text && <p>{text}</p>}
  <slot />
</div>
