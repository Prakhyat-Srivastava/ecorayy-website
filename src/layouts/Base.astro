---
// Fonts: Latin-only subsets (the ₹ sign falls back to the system font) and
// Devanagari-only Mukta, which downloads only when Hindi text is on the page.
import jakartaLatin from '@fontsource-variable/plus-jakarta-sans/files/plus-jakarta-sans-latin-wght-normal.woff2?url';
import monoLatin from '@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url';
import '@fontsource/mukta/devanagari-400.css';
import '@fontsource/mukta/devanagari-500.css';
import '@fontsource/mukta/devanagari-600.css';
import '@fontsource/mukta/devanagari-700.css';
import '../styles/global.css';
import { getImage } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Overlays from '../components/Overlays.astro';
import { images, type ImageId } from '../data/images';
import { basePath, hasHindi, ui } from '../data/i18n';
import { stripBase, u } from '../lib/url';
import { company, directors, IS_PREVIEW, type Lang } from '../data/site';

interface Props {
  title: string;
  description: string;
  lang?: Lang;
  ogImage?: ImageId;
  jsonLd?: Record<string, unknown>[];
}
const { title, description, lang = 'en', ogImage = 'br01', jsonLd = [] } = Astro.props;
const path = stripBase(Astro.url.pathname);
const base = basePath(path);
const site = Astro.site ?? new URL('https://ecorayy.example');
const fullTitle = base === '/' ? title : `${title} · Ecorayy`;
const og = await getImage({ src: images[ogImage].src, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 80 });
const t = ui[lang];

const org = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: company.legalNameTitle,
  alternateName: 'Ecorayy',
  url: new URL(u('/'), site).href,
  slogan: 'Brighter tomorrow together',
  foundingDate: company.incorporatedISO,
  identifier: [
    { '@type': 'PropertyValue', propertyID: 'CIN', value: company.cin },
    { '@type': 'PropertyValue', propertyID: 'GSTIN', value: company.gstin },
  ],
  address: {
    '@type': 'PostalAddress',
    streetAddress: company.registeredOffice.street,
    addressLocality: company.registeredOffice.city,
    addressRegion: company.registeredOffice.state,
    postalCode: company.registeredOffice.pin,
    addressCountry: 'IN',
  },
  member: directors.map((d) => ({ '@type': 'Person', name: d.name, jobTitle: 'Director' })),
};
---
<!doctype html>
<html lang={lang} dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {IS_PREVIEW && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#ffffff" />
    <link rel="preload" href={jakartaLatin} as="font" type="font/woff2" crossorigin />
    <style is:inline set:html={`
      @font-face { font-family: "Plus Jakarta Sans Variable"; font-style: normal; font-display: swap; font-weight: 200 800; src: url(${jakartaLatin}) format("woff2-variations"); unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD; }
      @font-face { font-family: "JetBrains Mono Variable"; font-style: normal; font-display: swap; font-weight: 100 800; src: url(${monoLatin}) format("woff2-variations"); unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD; }
    `} />
    <link rel="canonical" href={new URL(u(path), site).href} />
    {hasHindi(base) && (
      <>
        <link rel="alternate" hreflang="en-IN" href={new URL(u(base), site).href} />
        <link rel="alternate" hreflang="hi-IN" href={new URL(u(base === '/' ? '/hi/' : `/hi${base}`), site).href} />
      </>
    )}
    <link rel="icon" type="image/png" sizes="32x32" href={u('/favicon-32.png')} />
    <link rel="apple-touch-icon" href={u('/apple-touch-icon.png')} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Ecorayy" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(og.src, site).href} />
    <meta property="og:locale" content={lang === 'hi' ? 'hi_IN' : 'en_IN'} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify([org, ...jsonLd])} />
    <script is:inline>
      document.documentElement.classList.add('js');
      try { if (localStorage.getItem('ecorayy.showSamples') === '1') document.documentElement.classList.add('show-samples'); } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">{t.skip}</a>
    {IS_PREVIEW && (
      <div class="preview-banner no-print" role="note">
        <div class="container preview-banner__inner">
          <span><strong>{t.previewTitle}</strong> <span class="preview-banner__long">{t.previewText}</span></span>
          <button type="button" data-toggle-samples aria-pressed="false" data-on={t.hideSamples} data-off={t.showSamples}>{t.showSamples}</button>
        </div>
      </div>
    )}
    <Header lang={lang} path={path} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} />
    <Overlays lang={lang} path={path} />
    <script>
      import '../scripts/site';
      import '../scripts/quote-ui';
    </script>
  </body>
</html>
